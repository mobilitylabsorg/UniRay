<?xml version="1.0" encoding="utf-8"?>
<!-- The full (GitHub) edition's additions to src/main/AndroidManifest.xml:
     stealth mode. The Google Play edition (UNIRAY_STORE=play) leaves them
     out, as Play allows a device-wide tunnel only through VpnService. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Asks directly to leave battery optimization (Doze) for the "stay
         awake" setting; Play restricts this permission. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Stealth mode may be driven through Shizuku instead of root. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application>
        <!-- Stealth tunnel: a plain foreground service, not a VpnService, so it
             does not advertise itself as a VPN. It runs the standalone Xray as
             a root process and sets up the capture (tproxy/iptables or a
             root-owned TUN); the privileged work happens through the shell, not
             here. Shares the :vpn process so it survives the app being swept
             away, like the VpnService (never both at once). -->
        <service
            android:name=".StealthService"
            android:exported="false"
            android:process=":vpn"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="proxy" />
        </service>

        <!-- Shizuku client provider. Declared even though stealth prefers root:
             when Shizuku is started as root it can provide stealth too, and in
             ADB mode it still powers the non-stealth conveniences. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
