+/// UNIRAY: where to connect to the gateway on `port`: its pinned address
+/// (server-address), else server-name.
+pub fn gateway_address(params: &crate::model::params::TunnelParams, port: u16) -> String {
+    match params.server_address {
+        Some(ip) => format!("{ip}:{port}"),
+        None => server_name_with_port(&params.server_name, port).into_owned(),
+    }
