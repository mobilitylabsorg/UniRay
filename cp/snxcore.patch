 pub type PacketSender = Sender<Bytes>;
 pub type PacketReceiver = Receiver<Bytes>;
 
+/// UNIRAY: the tunnel's plaintext IP packets go either to a real TUN device
+/// (standalone) or, in engine mode, over a connected socketpair to the UniRay
+/// engine. Both expose the same async send/recv over &self.
+enum PacketDevice {
+    Tun(Arc<tun::AsyncDevice>),
+    Sock(tokio::net::UnixDatagram),
+}
+
+impl PacketDevice {
+    async fn send(&self, buf: &[u8]) -> std::io::Result<usize> {
+        match self {
+            PacketDevice::Tun(d) => d.send(buf).await,
+            PacketDevice::Sock(s) => s.send(buf).await,
+        }
+    }
+    async fn recv(&self, buf: &mut [u8]) -> std::io::Result<usize> {
+        match self {
+            PacketDevice::Tun(d) => d.recv(buf).await,
+            PacketDevice::Sock(s) => s.recv(buf).await,
+        }
+    }
+}
+
