 pub type PacketSender = Sender<Bytes>;
 pub type PacketReceiver = Receiver<Bytes>;
 
+/// UNIRAY: the tunnel's plaintext IP packets go either to a real TUN device
+/// (standalone) or, in engine mode, over a connected socketpair to the UniRay
+/// engine. Both expose the same async send/recv over &self.
+enum PacketDevice {
+    Tun(Arc<tun::AsyncDevice>),
+    #[cfg(unix)]
+    Sock(tokio::net::UnixDatagram),
+    Udp(tokio::net::UdpSocket),
+}
+
+impl PacketDevice {
+    async fn send(&self, buf: &[u8]) -> std::io::Result<usize> {
+        match self {
+            PacketDevice::Tun(d) => d.send(buf).await,
+            #[cfg(unix)]
+            PacketDevice::Sock(s) => s.send(buf).await,
+            PacketDevice::Udp(s) => s.send(buf).await,
+        }
+    }
+    async fn recv(&self, buf: &mut [u8]) -> std::io::Result<usize> {
+        match self {
+            PacketDevice::Tun(d) => d.recv(buf).await,
+            #[cfg(unix)]
+            PacketDevice::Sock(s) => s.recv(buf).await,
+            PacketDevice::Udp(s) => s.recv(buf).await,
+        }
+    }
+}
+
+/// UNIRAY: in engine mode no socket of this host reaches the tunnel, so the
+/// keepalive and the SCV report go in as whole IPv4/UDP packets from the
+/// Office Mode address.
+const ENGINE_KEEPALIVE_INTERVAL: Duration = Duration::from_secs(20);
+/// Once the gateway has answered, this long without an answer ends the tunnel
+/// (the engine starts it again).
+const ENGINE_KEEPALIVE_DEAD: Duration = Duration::from_secs(120);
+
+fn engine_udp_packet(src: Ipv4Addr, dst: Ipv4Addr, port: u16, payload: &[u8]) -> Vec<u8> {
+    let port = port.to_be_bytes();
+    let total = 20 + 8 + payload.len();
+    let mut packet = vec![0u8; total];
+    packet[0] = 0x45;
+    packet[2..4].copy_from_slice(&(total as u16).to_be_bytes());
+    packet[8] = 64;
+    packet[9] = 17;
+    packet[12..16].copy_from_slice(&src.octets());
+    packet[16..20].copy_from_slice(&dst.octets());
+    let sum = packet[..20]
+        .chunks(2)
+        .map(|word| u32::from(u16::from_be_bytes([word[0], word[1]])))
+        .sum::<u32>();
+    let sum = (sum & 0xffff) + (sum >> 16);
+    let sum = !(((sum & 0xffff) + (sum >> 16)) as u16);
+    packet[10..12].copy_from_slice(&sum.to_be_bytes());
+    packet[20..22].copy_from_slice(&port);
+    packet[22..24].copy_from_slice(&port);
+    packet[24..26].copy_from_slice(&((8 + payload.len()) as u16).to_be_bytes());
+    // The UDP checksum stays 0 (none), as the gateway expects.
+    packet[28..].copy_from_slice(payload);
+    packet
+}
+
+/// Whether `packet` is the gateway's answer to a keepalive.
+fn is_engine_keepalive_reply(packet: &[u8], gateway: Ipv4Addr) -> bool {
+    packet.len() >= 28 && packet[0] >> 4 == 4 && packet[9] == 17 && packet[12..16] == gateway.octets() && {
+        let udp = usize::from(packet[0] & 0x0f) * 4;
+        packet.len() >= udp + 4
+            && u16::from_be_bytes([packet[udp], packet[udp + 1]]) == TunnelParams::IPSEC_KEEPALIVE_PORT
+    }
+}
