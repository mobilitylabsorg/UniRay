+fn pick_login_type(info: &GatewayInformation, params: &TunnelParams) -> anyhow::Result<String> {
+    let user_defined = params.user_defined_factor.as_deref();
+    let has_cert = params.cert_type != CertType::None;
+    let has_password = !params.password.expose_secret().is_empty();
+    let options = info
+        .login_options_data
+        .as_ref()
+        .map(|data| data.login_options_list.values().cloned().collect::<Vec<_>>())
+        .unwrap_or_default();
+    if options.is_empty() {
+        return Ok(LoginOption::unspecified().id);
+    }
+    options
+        .iter()
+        .filter(|option| option.show_realm != 0 && !option.is_identity_provider() && !option.is_mobile_access())
+        .filter(|option| option.is_certificate(user_defined) == has_cert)
+        .max_by_key(|option| option.is_multi_factor(user_defined) == has_password)
+        .map(|option| option.id.clone())
+        .ok_or_else(|| {
+            let offered = options
+                .iter()
+                .map(|option| option.display_name.as_str())
+                .collect::<Vec<_>>();
+            anyhow::anyhow!("the gateway has no login for this: it offers {}", offered.join(", "))
+        })
